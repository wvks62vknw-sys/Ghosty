+test('the audio route streams an episode with its size, passes a Range on, refuses a web page, a private address and an episode over the cap', async () => {
+  const sent = [];
+  const bytes = new Uint8Array(32_000).fill(7);
+  const fetcher = async (u, init) => {
+    sent.push({ u, range: new Headers(init?.headers).get('range'), method: init?.method });
+    if (u.endsWith('/ep1.mp3')) {
+      const range = new Headers(init?.headers).get('range');
+      if (range === 'bytes=1000-') return ok(bytes.slice(1000), { 'content-type': 'audio/mpeg', 'content-length': String(bytes.length - 1000), 'content-range': `bytes 1000-${bytes.length - 1}/${bytes.length}` }, 206);
+      return ok(init?.method === 'HEAD' ? null : bytes, { 'content-type': 'audio/mpeg', 'content-length': String(bytes.length) });
+    }
+    if (u.endsWith('/page.html')) return ok('<html></html>', { 'content-type': 'text/html' });
+    if (u.endsWith('/huge.mp3')) return ok('x', { 'content-type': 'audio/mpeg', 'content-length': String(P.AUDIO_CAP + 1) });
+    throw new Error('not stood in');
+  };
+  const call = (target, init = {}) => P.podcastRoute(new Request(`https://g.test/api/podcast/audio?url=${encodeURIComponent(target)}`, init), new URL(`https://g.test/api/podcast/audio?url=${encodeURIComponent(target)}`), fetcher);
+  const whole = await call('https://cdn.allotment.example/ep1.mp3');
+  assert.equal(whole.status, 200);
+  assert.equal(whole.headers.get('content-length'), '32000');
+  assert.equal(whole.headers.get('x-podcast-size'), '32000');
+  assert.equal(whole.headers.get('content-disposition'), 'attachment');
+  assert.equal((await whole.arrayBuffer()).byteLength, 32000);
+  const head = await call('https://cdn.allotment.example/ep1.mp3', { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(head.headers.get('x-podcast-size'), '32000');
+  const part = await call('https://cdn.allotment.example/ep1.mp3', { headers: { range: 'bytes=1000-' } });
+  assert.equal(part.status, 206);
+  assert.equal(part.headers.get('x-podcast-size'), '32000');
+  assert.equal((await part.arrayBuffer()).byteLength, 31000);
+  assert.equal((await call('https://cdn.allotment.example/page.html')).status, 415);
+  const huge = await call('https://cdn.allotment.example/huge.mp3');
+  assert.equal(huge.status, 413);
+  assert.equal((await huge.json()).size, P.AUDIO_CAP + 1);
+  for (const bad of ['http://127.0.0.1/ep.mp3', 'http://169.254.169.254/latest/meta-data', 'http://[fd00::1]/a.mp3']) assert.equal((await call(bad)).status, 400, bad);
+  assert.ok(!sent.some((s) => /127\.0\.0\.1|169\.254|fd00/.test(s.u)));
+  // a range that is not one piece of a file is not passed on
+  await call('https://cdn.allotment.example/ep1.mp3', { headers: { range: 'bytes=0-1,5-9' } });
+  assert.equal(sent.at(-1).range, null);
+});
