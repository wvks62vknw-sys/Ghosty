+async function binsAhead(d: PackDeps, today: string): Promise<{ day: string; name: string }[]> {
+  const book = await load<BinBook>(d, 'home:bins', emptyBins()).catch(() => emptyBins());
+  if (!book?.bins?.length) return [];
+  const end = addDays(today, 42);
+  return book.bins
