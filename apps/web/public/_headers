# Cloudflare response headers for the interface. The main app gets a strict Content Security Policy:
# scripts only from this site, network only to this site (/api), no framing by others.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://server.arcgisonline.com https://tiles.maps.eox.at https://tile.openstreetmap.org https://*.tile.opentopomap.org https://*.tile-cyclosm.openstreetmap.fr https://*.tiles.openrailwaymap.org https://tiles.openseamap.org https://tilecache.rainviewer.com https://api.mapbox.com https://images.openfoodfacts.org https://images.openbeautyfacts.org https://images.openproductsfacts.org https://covers.openlibrary.org https://archive.org https://*.archive.org; connect-src 'self' https://huggingface.co https://*.hf.co https://overpass-api.de https://overpass.kumi.systems https://tiles.openfreemap.org https://api.mapbox.com https://*.tiles.openrailwaymap.org https://tilecache.rainviewer.com; worker-src 'self'; frame-src 'self' https://www.google.com https://embed.waze.com; media-src 'self' blob: https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), geolocation=(self), camera=(self)

# Widgets run here, inside a sandboxed iframe with an opaque origin, so they may use
# inline scripts and call public APIs without weakening the main app's policy.
# The training-ground test runner: runs code Ghosty wrote, in a sandbox with no network at all.
/runner
  ! Content-Security-Policy
  Content-Security-Policy: sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob:; worker-src blob:

/runner.html
  ! Content-Security-Policy
  Content-Security-Policy: sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob:; worker-src blob:

# Cloudflare serves this page at /widget-host (it redirects /widget-host.html there), so the rule
# must name that address: without it the page gets the app's "never in a frame" policy and every
# widget shows up as a blank white box.
/widget-host
  ! Content-Security-Policy
  Content-Security-Policy: sandbox allow-scripts; default-src * data: blob: 'unsafe-inline' 'unsafe-eval'

/widget-host.html
  ! Content-Security-Policy
  Content-Security-Policy: sandbox allow-scripts; default-src * data: blob: 'unsafe-inline' 'unsafe-eval'

/data/*
  Cache-Control: public, max-age=86400

# Leaflet (the flat map), MapLibre GL (the 3D map) and the Lens's vision and reading libraries
# (MediaPipe, Tesseract.js and their models), vendored: fixed versions, cached for a week. The
# 'wasm-unsafe-eval' above lets those WebAssembly runtimes compile; scripts still come only from here.
# MapLibre fetches OpenFreeMap's styles, vector tiles, fonts and sprites itself (connect-src above);
# its tile worker is a module from this same folder, so no blob: worker is ever needed.
# The offline brain (vendor/webllm): its runtime, worker and the model's compiled code are here; only the
# model's weights come from Hugging Face (huggingface.co, which redirects to its *.hf.co download hosts),
# fetched once and kept by the browser — hence those two in connect-src above.
/vendor/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
