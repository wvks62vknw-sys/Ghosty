// Ghosty: one Worker serves the interface (static files from apps/web/dist) and the
// brain (/api/*). PROTECTED: Ghosty cannot edit this file without a kernel unlock.
// The interface is built automatically when dependencies install (see package.json
// "postinstall"), so Cloudflare's default build settings work with no changes.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghosty",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "build": { "command": "npm run build:web" },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/i/*"]
  },
  "vars": {
    // SHA-256 of your owner password. The password itself is never stored anywhere.
    "OWNER_KEY_HASH": "a944f0946252df9f96bb93bedff208daebd404294a40fa18cc772a759ed08ab0",
    "OWNER_EMAIL": "aqishussain1@gmail.com",
    "GITHUB_REPO": "wvks62vknw-sys/Ghosty",
    // Where Ghosty lives: published links use this when a request does not say (background runs).
    "PUBLIC_ORIGIN": "https://ghosty.wvks62vknw.workers.dev"
  },
  // Workers AI: free daily allowance, no key — Ghosty's always-available fallback brain.
  "ai": { "binding": "AI" },
  // Pages Ghosty published (publish_site) and jobs in flight. KV is free and has its own daily
  // allowance, separate from the database's, so published links stay up — and publishing
  // works — while the database is paused.
  "kv_namespaces": [
    { "binding": "SITES", "id": "3ea76c576392464bb1f2726a18203ba4" },
    // The vault's mirror (encrypted keys, so they survive the database pause). Production only:
    // previews below do not get it, so an unreviewed change can never read the owner's keys.
    { "binding": "VAULT", "id": "7e48e1e22f274b4eb0bd5420f570cda3" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "GhostyAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GhostyAgent"] }],
  "observability": { "enabled": true },
  // Previews (one per proposed change) run code you have not approved yet, so they get
  // their own empty storage and NO owner credential: they show the interface only, and
  // never accept your password.
  "previews": {
    "vars": {
      "IS_PREVIEW": "1"
    },
    "ai": { "binding": "AI" },
    "kv_namespaces": [{ "binding": "SITES", "id": "3ea76c576392464bb1f2726a18203ba4" }],
    "durable_objects": {
      "bindings": [{ "name": "AGENT", "class_name": "GhostyAgent" }]
    }
  }
}
